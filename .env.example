# Public site — set this to https://jaynee.ng in production (Vercel)
NEXT_PUBLIC_SITE_URL=https://jaynee.ng

# Optional Search Console HTML tag content (the token only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional announcement bar (leave empty to hide)
NEXT_PUBLIC_ANNOUNCEMENT=

# Contact
NEXT_PUBLIC_CONTACT_PHONE=+234 703 666 3581
NEXT_PUBLIC_WHATSAPP_PHONE=+2347036663581
NEXT_PUBLIC_CONTACT_EMAIL=hello@jaynee.ng
NEXT_PUBLIC_STUDIO_ADDRESS=Studio address to be confirmed, Lagos, Nigeria
NEXT_PUBLIC_BUSINESS_HOURS=Monday–Saturday, 10:00–18:00 WAT
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com

# Placeholder bank details for transfer instructions
NEXT_PUBLIC_BANK_NAME=Bank name to be confirmed
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Account name to be confirmed
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000

# Session signing — generate a long random string before production
AUTH_SECRET=

# Demo admin (mock mode only)
MOCK_ADMIN_EMAIL=admin@jaynee.ng
MOCK_ADMIN_PASSWORD=demo-admin-login

# Supabase (leave empty to stay in mock mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — secret key must stay server-side
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave — secret key must stay server-side
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
